# Configuracion para correr el backend en local (PostgreSQL de tu PC).
# No entra en la imagen de Docker: en Render se usan los valores de application.properties.
# Si tu PostgreSQL usa otra contrasena, cambiala en SPRING_DATASOURCE_PASSWORD.
# Para usar la base de Render desde tu PC, borra o renombra este archivo.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bd_proyect_arqui_backend
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgre
